{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd Backend && dotnet publish SimpleFinance.Api.csproj -c Release -o out"
  },
  "deploy": {
    "startCommand": "cd Backend && dotnet out/SimpleFinance.Api.dll",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
